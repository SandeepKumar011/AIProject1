pipeline{
    agent any
    stages{
        stage('Build'){
            steps{
                echo 'Building testing...'
            }
        }
        stage('Test'){
            steps{
                echo 'Testing... is in progresss'
                 bat 'mvn test'
            }
        }
        stage('Deploy'){
            steps{
                echo 'Deploying... also in progress'
            }
        }
    }

}